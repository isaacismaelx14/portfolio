---
interface Props {
    text: string;
}

const { text } = Astro.props;
---

<span
    class="inline-flex items-center gap-1.5 text-xs font-mono font-medium text-gray-600 dark:text-gray-400"
>
    <span class="h-1.5 w-1.5 rounded-full bg-blue-500 dark:bg-blue-400" aria-hidden="true"></span>
    {text}
</span>
