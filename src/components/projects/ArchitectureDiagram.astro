---
import { useTranslations } from "../../i18n/utils";
import type { Lang } from "../../types";

interface Props {
    lang: Lang;
    label: string;
    entries: string[];
    modules: { name: string; planned?: boolean }[];
    store: string;
}

const { lang, label, entries, modules, store } = Astro.props;
const t = useTranslations(lang);
const hasPlanned = modules.some((module) => module.planned);
---

<div
    role="img"
    aria-label={label}
    class="w-full h-full flex flex-col items-center justify-center gap-2 p-4 sm:p-6 font-mono text-xs text-gray-700 dark:text-gray-300 bg-gray-50 dark:bg-gray-900"
>
    <div class="flex flex-wrap justify-center gap-2" aria-hidden="true">
        {
            entries.map((entry) => (
                <span class="px-3 py-1.5 rounded-md border border-blue-300 dark:border-blue-700 bg-blue-50 dark:bg-blue-950 text-blue-700 dark:text-blue-300">
                    {entry}
                </span>
            ))
        }
    </div>

    <span class="text-gray-400 dark:text-gray-500 leading-none" aria-hidden="true">↓</span>

    <div
        class="w-full max-w-sm rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 p-3"
        aria-hidden="true"
    >
        <p class="text-center text-[11px] uppercase tracking-wider text-gray-500 dark:text-gray-400 mb-2">
            {t("projects.diagram.modules")}
        </p>
        <div class="flex flex-wrap justify-center gap-1.5">
            {
                modules.map((module) => (
                    <span
                        class:list={[
                            "px-2 py-1 rounded border",
                            module.planned
                                ? "border-dashed border-gray-300 dark:border-gray-600 text-gray-500 dark:text-gray-400"
                                : "border-gray-300 dark:border-gray-500 bg-gray-100 dark:bg-gray-700 text-gray-800 dark:text-gray-100",
                        ]}
                    >
                        {module.name}
                    </span>
                ))
            }
        </div>
    </div>

    <span class="text-gray-400 dark:text-gray-500 leading-none" aria-hidden="true">↓</span>

    <span
        class="px-3 py-1.5 rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800"
        aria-hidden="true"
    >
        {store}
    </span>

    {
        hasPlanned && (
            <p class="flex items-center gap-1.5 text-[11px] text-gray-500 dark:text-gray-400 mt-1" aria-hidden="true">
                <span class="inline-block w-3 h-2 rounded-sm border border-dashed border-gray-400 dark:border-gray-500" />
                {t("projects.diagram.planned")}
            </p>
        )
    }
</div>
