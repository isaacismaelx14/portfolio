---
import TerminalHeader from "../TerminalHeader.astro";

interface Props {
    company: string;
    title: string;
    problem: string;
    decision: string;
    outcome: string;
    tags: string[];
    labels: { problem: string; decision: string; outcome: string };
}

const { company, title, problem, decision, outcome, tags, labels } =
    Astro.props;

const steps = [
    { label: labels.problem, body: problem },
    { label: labels.decision, body: decision },
    { label: labels.outcome, body: outcome },
];
---

<article
    class="h-full flex flex-col bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 shadow-sm overflow-hidden"
>
    <div
        class="bg-gray-50 dark:bg-gray-900 px-4 py-3 border-b border-gray-200 dark:border-gray-700 flex items-center justify-between gap-3"
    >
        <TerminalHeader variant="compact" />
        <span
            class="text-xs font-mono text-gray-500 dark:text-gray-400 truncate"
        >
            {company}
        </span>
    </div>

    <div class="p-5 sm:p-6 flex flex-col flex-grow">
        <h3
            class="text-lg sm:text-xl font-bold tracking-tight text-gray-900 dark:text-white mb-5"
        >
            {title}
        </h3>

        <dl class="space-y-4 flex-grow">
            {
                steps.map((step) => (
                    <div class="pl-4 border-l-2 border-blue-200 dark:border-blue-800">
                        <dt class="text-xs font-mono font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400 mb-1">
                            {step.label}
                        </dt>
                        <dd class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
                            {step.body}
                        </dd>
                    </div>
                ))
            }
        </dl>

        <ul
            class="flex flex-wrap gap-2 mt-6 pt-4 border-t border-dashed border-gray-200 dark:border-gray-700"
            aria-label="Stack"
        >
            {
                tags.map((tag) => (
                    <li class="text-xs font-mono px-2 py-0.5 rounded bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 border border-gray-200 dark:border-gray-600">
                        {tag}
                    </li>
                ))
            }
        </ul>
    </div>
</article>
